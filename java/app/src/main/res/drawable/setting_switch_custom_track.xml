<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/_40sdp" />
            <gradient android:startColor="#00ffd554" android:endColor="#4dffd554" android:angle="0.0" android:type="linear" />
            <stroke android:width="@dimen/_2sdp" android:color="#ffffd554" android:dashWidth="@dimen/_10sdp" android:dashGap="@dimen/_3sdp" />
            <size android:height="@dimen/_20sdp" />
        </shape>
    </item>
    <item android:state_checked="false">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/_40sdp" />
            <gradient android:startColor="#00ffffff" android:endColor="#4dffffff" android:angle="180.0" android:type="linear" />
            <stroke android:width="@dimen/_2sdp" android:color="#57ffffff" android:dashWidth="@dimen/_10sdp" android:dashGap="@dimen/_3sdp" />
            <size android:height="@dimen/_20sdp" />
        </shape>
    </item>
</selector>