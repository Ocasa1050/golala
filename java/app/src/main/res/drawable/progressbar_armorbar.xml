<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <gradient android:startColor="#00000000" android:endColor="#00000000" android:angle="0.0" android:centerColor="#00000000" />
            <corners android:radius="25.0dip" />
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape>
                <gradient android:startColor="#ffb9b9b9" android:endColor="#ff484848" android:angle="270.0" android:centerColor="#ff7a7a7a" />
                <corners android:radius="25.0dip" />
            </shape>
        </clip>
    </item>
    <item android:id="@android:id/progress">
        <scale android:scaleWidth="100%">
            <shape>
                <gradient android:startColor="#ffb9b9b9" android:endColor="#ff484848" android:angle="270.0" android:centerColor="#ff7a7a7a" />
                <corners android:radius="25.0dip" />
            </shape>
        </scale>
    </item>
</layer-list>